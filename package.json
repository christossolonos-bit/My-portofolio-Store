{
  "name": "my-portofolio-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n store,guide -c cyan,magenta \"vite\" \"npm run assistant:dev\"",
    "dev:store": "vite",
    "build": "node scripts/railway-build.mjs",
    "build:store": "tsc -b && vite build",
    "start": "node scripts/railway-start.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "tours": "node scripts/tours/build-all.mjs",
    "assistant:install": "npm install --prefix assistant",
    "assistant:seed": "node assistant/scripts/seed-solonaras.mjs",
    "assistant:dev": "npm run assistant:seed && npm run dev --prefix assistant"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.186.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serve": "^14.2.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "puppeteer": "^25.16.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
