# Public site URL (OG / share links)
VITE_SITE_URL=https://your-store.up.railway.app

# Assistant API (Railway assistant service origin, no trailing slash)
VITE_ASSISTANT_URL=https://your-assistant.up.railway.app

# Optional Discord invite override
VITE_DISCORD_INVITE=https://discord.gg/reZX2sqQk

# Shopify (Option 1) — defaults to christossolonos.myshopify.com
# Import catalog: shopify/products-import.csv → Admin → Products → Import
# Default handles match project ids (luna-agent, luna-gaida, …)
VITE_SHOPIFY_STORE=christossolonos.myshopify.com
# Optional override if a Shopify handle differs from the project id
# VITE_SHOPIFY_HANDLES={"luna-agent":"luna-agent-5-0"}
# Optional later: project id → variant id for cart checkout
# VITE_SHOPIFY_VARIANTS={"luna-agent":"12345678901234"}

# Optional webhook after contact form (Zapier / Discord proxy)
VITE_CONTACT_WEBHOOK_URL=

# Optional analytics collector endpoint
VITE_ANALYTICS_URL=
