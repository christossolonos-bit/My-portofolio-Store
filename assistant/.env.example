# Required — NVIDIA NIM (https://build.nvidia.com → Generate API Key)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# TTS: edge (free) or fish
TTS_PROVIDER=edge
EDGE_VOICE_EL=el-GR-AthinaNeural
EDGE_VOICE_EN=en-US-AvaMultilingualNeural

# Optional Fish Audio STT + cloned voices
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_REFERENCE_ID_EN=
FISH_TTS_MODEL=s2.1-pro-free

ADMIN_SECRET=solonaras-change-me
SITE_BASE_URL=http://localhost:5173
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false

# portfolio = Solonaras Store only (no YGIA shop / phone handoffs)
ASSISTANT_MODE=portfolio

# Optional later: Stripe Checkout (not used in the store UI yet)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
